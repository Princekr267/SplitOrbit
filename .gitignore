# ==============================================================================
# Git Ignore - SplitTrack (PERN Stack Monorepo)
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# Keep sample files tracked (.env.example), never commit real credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.env
backend/.env
frontend/.env
frontend/.env.*.local
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# Build & Distribution Outputs
# ------------------------------------------------------------------------------
dist/
dist-ssr/
build/
out/
frontend/dist/

# ------------------------------------------------------------------------------
# Caches & Temporary Files
# ------------------------------------------------------------------------------
.cache/
.vite/
.parcel-cache/
.turbo/
*.tsbuildinfo
.eslintcache
.oxlint_cache/
tmp/
temp/
*.tmp
*.temp
scratch/

# ------------------------------------------------------------------------------
# Logs & Process Outputs
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Testing, Test Suites & Code Coverage
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
test-reports/
playwright-report/
blob-report/
.vitest/

# Test files and test directories
**/__tests__/
**/*.test.*
**/*.spec.*
backend/src/tests/

# ------------------------------------------------------------------------------
# Database & Local Dumps
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sql.gz
*.sql.tar
*.dump

# ------------------------------------------------------------------------------
# Operating System & Editor Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# IDEs & Editors
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swn

# VS Code (preserve shared workspace settings & extensions, ignore personal state)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.log

# ------------------------------------------------------------------------------
# AI Agent Workspaces (.agents/)
# NOTE: Do NOT ignore `.agents/` as a whole!
# Skills (e.g. frontend-ui-design, ponytail) and workspace rules should be committed
# so team members and other environments share the same AI design and coding standards.
# Only ignore runtime caches and temporary scratchpads below:
# ------------------------------------------------------------------------------
.agents/**/.cache/
.agents/**/tmp/
.agents/**/scratch/