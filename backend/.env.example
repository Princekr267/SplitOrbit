PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://splittrack:splittrack@localhost:5432/splittrack
TEST_DATABASE_URL=postgresql://splittrack:splittrack@localhost:5433/splittrack_test

# Auth & Session Security
# JWT_SECRET must be at least 32 characters in production
JWT_SECRET=super_secret_jwt_key_splittrack_2026_dev
JWT_EXPIRES_IN=7d

# Frontend Origin for strict CORS allow-list and link generation (invites, view links, reset links)
# In production, this must match the public domain (e.g., https://our-split-track.vercel.app)
FRONTEND_URL=http://localhost:5173

# Secret pepper for HMAC-SHA256 hashing of recovery and reset codes
RECOVERY_PEPPER=change_this_to_a_random_32_character_secret_key
